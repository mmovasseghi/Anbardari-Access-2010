<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>Anbarban</AssemblyName>
    <RootNamespace>Anbarban</RootNamespace>
    <StartupObject>Anbarban.Program</StartupObject>
    <Version>3.0.3</Version>
    <Company>انباربان</Company>
    <Product>Anbarban Warehouse</Product>
    <Description>انباربان — اپ ویندوز با پایگاه Access</Description>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="Microsoft.VisualBasic" />
    <Reference Include="System.Configuration" />
    <Reference Include="System.Data" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\logo.png" />
    <Resource Include="Assets\Icons\*.png" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\database\Inventory.accdb" Link="Data\Inventory.accdb" Condition="Exists('..\..\database\Inventory.accdb')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="App.config" />
  </ItemGroup>
</Project>
