<Page x:Class="Anbarban.Views.DepartmentsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:services="clr-namespace:Anbarban.Services"
      services:MouseWheelScrollHelper.Enable="True"
      Background="{StaticResource BrushBgDeep}" FlowDirection="RightToLeft" FontFamily="{StaticResource FontUi}">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Text="مدیریت بخش‌ها" Style="{StaticResource PageTitle}"/>
    <StackPanel Grid.Row="1" Margin="0,8,0,0">
      <TextBlock Style="{StaticResource HintText}"
                 Text="نام بخش را پایین بنویسید و ذخیره کنید. برای عوض کردن، از لیست یکی را انتخاب کنید."/>
      <TextBox x:Name="TxtFilter" Width="360" HorizontalAlignment="Right" Margin="0,10,0,0"
               AutomationProperties.AutomationId="Departments.Filter"
               ToolTip="برای پیدا کردن سریع‌تر، اینجا تایپ کنید"/>
    </StackPanel>

    <Border Grid.Row="2" Style="{StaticResource CardPanel}" Margin="8,8,8,0" Padding="0">
      <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True"
                SelectionChanged="OnSelect" MinHeight="200">
        <DataGrid.Columns>
          <DataGridTextColumn Header="نام بخش" Binding="{Binding Name}" Width="*"/>
          <DataGridTextColumn Header="فعال" Binding="{Binding ActiveLabel}" Width="72"/>
        </DataGrid.Columns>
      </DataGrid>
    </Border>

    <Border Grid.Row="3" Style="{StaticResource CardPanel}" Margin="8,12,8,0">
      <StackPanel>
        <TextBlock Text="نام بخش *" Foreground="{StaticResource BrushMuted}"/>
        <TextBox x:Name="TxtName" Margin="0,6,0,10" AutomationProperties.AutomationId="Departments.Name"/>
        <CheckBox x:Name="ChkActive" Content="فعال (در حواله خروج دیده شود)" IsChecked="True"/>
      </StackPanel>
    </Border>

    <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="8,16,8,0">
      <Button Style="{StaticResource ToolbarButton}" Content="فرم خالی (جدید)" Click="OnNew"/>
      <Button Style="{StaticResource PrimaryActionButton}" Content="ذخیره بخش" Click="OnSave" Padding="20,12"/>
      <Button Style="{StaticResource ToolbarButton}" Content="بازگشت به منو" Click="OnBack"/>
    </StackPanel>
  </Grid>
</Page>
