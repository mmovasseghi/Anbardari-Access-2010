<Page x:Class="Anbarban.Views.PlaceholderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BrushBgDeep}"
      FlowDirection="RightToLeft"
      FontFamily="{StaticResource FontUi}">
  <StackPanel Margin="32" MaxWidth="700" HorizontalAlignment="Center" VerticalAlignment="Center">
    <TextBlock x:Name="TxtTitle" Style="{StaticResource PageTitle}" TextAlignment="Center"/>
    <TextBlock x:Name="TxtBody" Style="{StaticResource Subtitle}" Margin="0,12,0,24" TextAlignment="Center" TextWrapping="Wrap"/>
    <Button Style="{StaticResource MenuTileButton}" Content="بازگشت به منو" HorizontalAlignment="Center" Click="OnBack"/>
  </StackPanel>
</Page>
