<Page x:Class="Anbarban.Views.SuppliersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BrushBgDeep}" FlowDirection="RightToLeft" FontFamily="{StaticResource FontUi}">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock Text="مدیریت فروشندگان" Style="{StaticResource PageTitle}"/>
    <DataGrid x:Name="Grid" Grid.Row="1" Margin="0,16,0,8" AutoGenerateColumns="False" IsReadOnly="True"
              SelectionChanged="OnSelect">
      <DataGrid.Columns>
        <DataGridTextColumn Header="نام" Binding="{Binding Name}" Width="*"/>
        <DataGridTextColumn Header="مشخصات" Binding="{Binding Info}" Width="2*"/>
        <DataGridCheckBoxColumn Header="فعال" Binding="{Binding Active}" Width="60"/>
      </DataGrid.Columns>
    </DataGrid>
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="2*"/>
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="نام فروشنده" Foreground="{StaticResource BrushMuted}"/>
        <TextBox x:Name="TxtName" Height="32" Margin="0,4,0,8"/>
        <CheckBox x:Name="ChkActive" Content="فعال" Foreground="{StaticResource BrushText}" IsChecked="True"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Margin="16,0,0,0">
        <TextBlock Text="مشخصات" Foreground="{StaticResource BrushMuted}"/>
        <TextBox x:Name="TxtInfo" Height="60" TextWrapping="Wrap" Margin="0,4,0,8"/>
      </StackPanel>
    </Grid>
    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
      <Button Style="{StaticResource MenuTileButton}" Content="جدید" Click="OnNew"/>
      <Button Style="{StaticResource PrimaryActionButton}" Content="ذخیره" Click="OnSave"/>
      <Button Style="{StaticResource MenuTileButton}" Content="بازگشت" Click="OnBack"/>
    </StackPanel>
  </Grid>
</Page>
