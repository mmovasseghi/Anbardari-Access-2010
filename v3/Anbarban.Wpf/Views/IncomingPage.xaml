<Page x:Class="Anbarban.Views.IncomingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ctrl="clr-namespace:Anbarban.Controls"
      xmlns:services="clr-namespace:Anbarban.Services"
      services:MouseWheelScrollHelper.Enable="True"
      Background="{StaticResource BrushBgDeep}" FlowDirection="RightToLeft" FontFamily="{StaticResource FontUi}"
      VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
  <Grid>
    <ScrollViewer x:Name="FormScroll" Padding="24" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel MaxWidth="950">
        <TextBlock Text="ثبت ورود کالا" Style="{StaticResource PageTitle}"/>
        <TextBlock x:Name="TxtStatus" Style="{StaticResource Subtitle}" Margin="0,4,0,16"/>

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,12,0">
            <ctrl:IconLabel Label="شماره سند *" IconSource="/Assets/Icons/incoming.png" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtDocNo" Margin="0,4,0,10" AutomationProperties.AutomationId="Incoming.DocNo"/>
            <ctrl:IconLabel Label="شماره فاکتور" IconSource="/Assets/Icons/reports.png" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtInvoice" Margin="0,4,0,10" AutomationProperties.AutomationId="Incoming.Invoice"/>
            <ctrl:IconLabel Label="تاریخ شمسی" IconSource="/Assets/Icons/stock.png" Margin="0,0,0,4"/>
            <ctrl:JalaliDatePicker x:Name="PickerJalali" Margin="0,4,0,10"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="12,0,0,0">
            <ctrl:IconLabel Label="فروشنده *" IconSource="/Assets/Icons/suppliers.png" Margin="0,0,0,4"/>
            <ctrl:SearchComboBox x:Name="CboSupplier" Margin="0,4,0,4"
                                 AutomationProperties.AutomationId="Incoming.Supplier"/>
            <TextBlock Style="{StaticResource HintText}" Text="چند حرف از نام فروشنده را بنویسید؛ لیست کوتاه می‌شود." Margin="0,0,0,10"/>
            <ctrl:IconLabel Label="توضیحات" IconSource="/Assets/Icons/home.png" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtDesc" Height="70" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,4,0,10"/>
          </StackPanel>
        </Grid>

        <StackPanel Orientation="Horizontal" Margin="0,8,0,16">
          <Button x:Name="BtnSave" Style="{StaticResource MenuTileButton}" Content="ذخیره اطلاعات فاکتور" Click="OnSaveHeader"/>
          <Button x:Name="BtnUnlock" Style="{StaticResource MenuTileButton}" Content="باز کردن با کد مدیر" Click="OnUnlock" Visibility="Collapsed"/>
        </StackPanel>

        <TextBlock Text="اقلام فاکتور" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrushText}" Margin="0,8,0,8"/>
        <DataGrid x:Name="GridLines" Height="220" AutoGenerateColumns="False" IsReadOnly="True">
          <DataGrid.Columns>
            <DataGridTextColumn Header="کالا" Binding="{Binding ProductName}" Width="*"/>
            <DataGridTextColumn Header="تعداد" Binding="{Binding Quantity}" Width="80"/>
          </DataGrid.Columns>
        </DataGrid>
        <StackPanel Orientation="Horizontal" Margin="0,10,0,20">
          <Button x:Name="BtnAddLine" Style="{StaticResource MenuTileButton}" Content="افزودن قلم" Click="OnAddLine"/>
          <Button Style="{StaticResource MenuTileButton}" Content="حذف قلم انتخابی" Click="OnDelLine"/>
          <Button x:Name="BtnReview" Style="{StaticResource PrimaryActionButton}" Content="بررسی و ثبت ورود" Click="OnReview"/>
        </StackPanel>
        <Button Style="{StaticResource MenuTileButton}" Content="بازگشت به منو" HorizontalAlignment="Left" Click="OnBack"/>
      </StackPanel>
    </ScrollViewer>

    <ctrl:PostSuccessPanel x:Name="PostedPanel" Visibility="Collapsed"/>
  </Grid>
</Page>
