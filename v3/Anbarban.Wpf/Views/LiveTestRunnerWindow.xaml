<Window x:Class="Anbarban.Views.LiveTestRunnerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تست زنده انباربان"
        Width="1100" Height="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushBgDeep}"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource FontUi}">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="300"/>
      <ColumnDefinition Width="12"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,12">
      <TextBlock Text="تست زنده — مرحله‌به‌مرحله" FontSize="22" FontWeight="SemiBold"
                 Foreground="{StaticResource BrushGold}"/>
      <TextBlock x:Name="TxtCurrent" Text="آماده…" FontSize="15" Margin="0,6,0,0"
                 Foreground="{StaticResource BrushText}" TextWrapping="Wrap"/>
    </StackPanel>

    <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource BrushBgCard}"
            BorderBrush="{StaticResource BrushAccentDark}" BorderThickness="1" CornerRadius="8" Padding="8">
      <ListBox x:Name="StepsList" BorderThickness="0" Background="Transparent"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
    </Border>

    <Border Grid.Row="1" Grid.Column="2" Background="{StaticResource BrushBgCard}"
            BorderBrush="{StaticResource BrushAccentDark}" BorderThickness="1" CornerRadius="8">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="TxtPreviewCaption" Grid.Row="0" Margin="12,10,12,6"
                   Foreground="{StaticResource BrushMuted}" FontSize="13"/>
        <Frame x:Name="PreviewFrame" Grid.Row="1" NavigationUIVisibility="Hidden" Margin="4"/>
        <ContentControl x:Name="PreviewHost" Grid.Row="1" Margin="16" VerticalAlignment="Center"/>
      </Grid>
    </Border>

    <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,12,0,0">
      <TextBlock x:Name="TxtResult" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"/>
      <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
        <Button x:Name="BtnStart" Content="▶ شروع تست زنده" Padding="24,12" FontSize="16"
                Style="{StaticResource PrimaryActionButton}" Click="OnStart"/>
        <Button x:Name="BtnAgain" Content="اجرای مجدد" Margin="12,0,0,0" Padding="20,10"
                Style="{StaticResource MenuTileButton}" Click="OnStart" Visibility="Collapsed"/>
        <Button x:Name="BtnClose" Content="بستن" Margin="12,0,0,0" Padding="20,10"
                Style="{StaticResource MenuTileButton}" Click="OnClose" Visibility="Collapsed"/>
      </StackPanel>
    </StackPanel>

    <Border x:Name="StartOverlay" Grid.RowSpan="3" Grid.ColumnSpan="3"
            Background="#CC0A0F0E" CornerRadius="8">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="480">
        <TextBlock Text="تست زنده انباربان" FontSize="26" FontWeight="Bold"
                   Foreground="{StaticResource BrushGold}" HorizontalAlignment="Center"/>
        <TextBlock Text="روی دکمه زیر بزنید. مراحل یکی‌یکی در همین پنجره دیده می‌شوند (پاک DB، صفحات، ورود/خروج، کمبوباکس، قلم کالا)."
                   TextWrapping="Wrap" Margin="0,16,0,24" FontSize="15"
                   Foreground="{StaticResource BrushText}" HorizontalAlignment="Center" TextAlignment="Center"/>
        <Button Content="▶ شروع" Padding="32,14" FontSize="18" HorizontalAlignment="Center"
                Style="{StaticResource PrimaryActionButton}" Click="OnStart"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
