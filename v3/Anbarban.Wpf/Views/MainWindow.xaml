<Window x:Class="Anbarban.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:Anbarban.Controls"
        Title="انباربان"
        Height="780" Width="1180"
        MinHeight="620" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushBgDeep}"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource FontUi}"
        Icon="/Assets/logo.png">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#FF0D1412" Padding="14,10" BorderBrush="{StaticResource BrushAccentDark}" BorderThickness="0,0,0,1">
      <Grid FlowDirection="LeftToRight">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="TxtDbStatus" Grid.Column="0" VerticalAlignment="Center"
                   Foreground="{StaticResource BrushMuted}" FontSize="12" TextWrapping="Wrap" MaxWidth="280"/>

        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0" FlowDirection="RightToLeft">
          <TextBlock x:Name="TxtPageTitle" Text="انباربان" FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrushText}"/>
          <TextBlock x:Name="TxtPageSubtitle" Text="دکمه منو بالا سمت راست" Style="{StaticResource Subtitle}"/>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right"
                    FlowDirection="LeftToRight">
          <Image Source="/Assets/logo.png" Height="44" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality"/>
          <Button x:Name="BtnMenu" Style="{StaticResource HamburgerButton}" Click="OnToggleMenu"
                  ToolTip="باز و بسته کردن منو"
                  AutomationProperties.Name="منو"
                  AutomationProperties.AutomationId="Menu.Toggle"/>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" x:Name="ContentHost" FlowDirection="LeftToRight">
      <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden"
             VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>

      <Border x:Name="MenuOverlay" Background="#AA050A08" Visibility="Collapsed"
              MouseDown="OnOverlayClick" Opacity="0"/>

      <Border x:Name="NavDrawer" Width="320" HorizontalAlignment="Right"
              Visibility="Collapsed" Panel.ZIndex="2" FlowDirection="RightToLeft"
              RenderTransformOrigin="1,0.5">
        <Border.RenderTransform>
          <TranslateTransform x:Name="NavDrawerTransform" X="320"/>
        </Border.RenderTransform>
        <Border.Effect>
          <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.55" Color="#FF000000"/>
        </Border.Effect>
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FF0E1613" Offset="0"/>
            <GradientStop Color="#FF0A100E" Offset="1"/>
          </LinearGradientBrush>
        </Border.Background>
        <Border BorderBrush="#FF243830" BorderThickness="1,0,0,0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Padding="22,22,22,18" BorderBrush="#FF243830" BorderThickness="0,0,0,1">
              <StackPanel FlowDirection="RightToLeft">
                <Image Source="/Assets/logo.png" Height="72" HorizontalAlignment="Right"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="انباربان" FontSize="24" FontWeight="Bold" Foreground="{StaticResource BrushGold}"
                           HorizontalAlignment="Stretch" TextAlignment="Right" Margin="0,14,0,0"/>
                <TextBlock Text="ورود، خروج، موجودی و گزارش" Style="{StaticResource Subtitle}"
                           HorizontalAlignment="Stretch" TextAlignment="Right" Margin="0,6,0,0"/>
              </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,4,0,12">
              <StackPanel>
                <TextBlock Text="هر روز" Style="{StaticResource NavSectionTitle}"/>
                <Button x:Name="NavHome" Style="{StaticResource NavDrawerButton}" Click="OnNavHome" Tag="nav"
                        AutomationProperties.Name="منو: خانه"
                        AutomationProperties.AutomationId="Nav.Home">
                  <ctrl:NavMenuRow Label="خانه">
                    <ctrl:NavMenuRow.IconSource>
                      <BitmapImage UriSource="/Assets/Icons/home.png"/>
                    </ctrl:NavMenuRow.IconSource>
                  </ctrl:NavMenuRow>
                </Button>
                <Button x:Name="NavIncoming" Style="{StaticResource NavDrawerButton}" Click="OnNavIncoming"
                        AutomationProperties.Name="منو: ثبت ورود کالا"
                        AutomationProperties.AutomationId="Nav.Incoming">
                  <ctrl:NavMenuRow Label="ثبت ورود کالا">
                    <ctrl:NavMenuRow.IconSource>
                      <BitmapImage UriSource="/Assets/Icons/incoming.png"/>
                    </ctrl:NavMenuRow.IconSource>
                  </ctrl:NavMenuRow>
                </Button>
                <Button x:Name="NavOutgoing" Style="{StaticResource NavDrawerButton}" Click="OnNavOutgoing"
                        AutomationProperties.Name="منو: ثبت خروج"
                        AutomationProperties.AutomationId="Nav.Outgoing">
                  <ctrl:NavMenuRow Label="ثبت خروج / حواله">
                    <ctrl:NavMenuRow.IconSource>
                      <BitmapImage UriSource="/Assets/Icons/outgoing.png"/>
                    </ctrl:NavMenuRow.IconSource>
                  </ctrl:NavMenuRow>
                </Button>
                <Button x:Name="NavStock" Style="{StaticResource NavDrawerButton}" Click="OnNavStock"
                        AutomationProperties.Name="منو: موجودی انبار"
                        AutomationProperties.AutomationId="Nav.Stock">
                  <ctrl:NavMenuRow Label="موجودی انبار">
                    <ctrl:NavMenuRow.IconSource>
                      <BitmapImage UriSource="/Assets/Icons/stock.png"/>
                    </ctrl:NavMenuRow.IconSource>
                  </ctrl:NavMenuRow>
                </Button>
                <Button x:Name="NavReports" Style="{StaticResource NavDrawerButton}" Click="OnNavReports"
                        AutomationProperties.Name="منو: گزارش‌ها"
                        AutomationProperties.AutomationId="Nav.Reports">
                  <ctrl:NavMenuRow Label="گزارش‌ها">
                    <ctrl:NavMenuRow.IconSource>
                      <BitmapImage UriSource="/Assets/Icons/reports.png"/>
                    </ctrl:NavMenuRow.IconSource>
                  </ctrl:NavMenuRow>
                </Button>

                <Rectangle Height="1" Margin="20,12" Fill="#FF243830"/>
                <TextBlock Text="تعریف پایه" Style="{StaticResource NavSectionTitle}" Margin="20,8,20,6"/>

                <Button x:Name="NavProducts" Style="{StaticResource NavDrawerButton}" Click="OnNavProducts"
                        AutomationProperties.Name="منو: کالاها"
                        AutomationProperties.AutomationId="Nav.Products">
                  <ctrl:NavMenuRow Label="کالاها">
                    <ctrl:NavMenuRow.IconSource>
                      <BitmapImage UriSource="/Assets/Icons/products.png"/>
                    </ctrl:NavMenuRow.IconSource>
                  </ctrl:NavMenuRow>
                </Button>
                <Button x:Name="NavSuppliers" Style="{StaticResource NavDrawerButton}" Click="OnNavSuppliers"
                        AutomationProperties.Name="منو: فروشندگان"
                        AutomationProperties.AutomationId="Nav.Suppliers">
                  <ctrl:NavMenuRow Label="فروشندگان">
                    <ctrl:NavMenuRow.IconSource>
                      <BitmapImage UriSource="/Assets/Icons/suppliers.png"/>
                    </ctrl:NavMenuRow.IconSource>
                  </ctrl:NavMenuRow>
                </Button>
                <Button x:Name="NavDepts" Style="{StaticResource NavDrawerButton}" Click="OnNavDepts"
                        AutomationProperties.Name="منو: بخش‌ها"
                        AutomationProperties.AutomationId="Nav.Depts">
                  <ctrl:NavMenuRow Label="بخش‌ها">
                    <ctrl:NavMenuRow.IconSource>
                      <BitmapImage UriSource="/Assets/Icons/departments.png"/>
                    </ctrl:NavMenuRow.IconSource>
                  </ctrl:NavMenuRow>
                </Button>
              </StackPanel>
            </ScrollViewer>

            <TextBlock Grid.Row="2" Margin="20,6,20,14" FontSize="10" Foreground="{StaticResource BrushMuted}"
                       TextAlignment="Right" HorizontalAlignment="Stretch" Text="آیکون‌ها: Icons8.com"/>
          </Grid>
        </Border>
      </Border>
    </Grid>

    <Border Grid.Row="2" Background="#FF0D1412" Padding="10,6">
      <TextBlock HorizontalAlignment="Center" Foreground="{StaticResource BrushMuted}" FontSize="11"
                 Text="نسخه ۳ — انباربان | آیکون‌ها از Icons8"/>
    </Border>
  </Grid>
</Window>
