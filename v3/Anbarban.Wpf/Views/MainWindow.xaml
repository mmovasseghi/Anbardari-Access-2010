<Window x:Class="Anbarban.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="انباربان"
        Height="720" Width="1100"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushBgDeep}"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource FontUi}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- هدر -->
    <Border Grid.Row="0" Background="#FF0D1412" Padding="20,14" BorderBrush="{StaticResource BrushAccentDark}" BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Image Grid.Column="0" Source="/Assets/logo.png" Height="52" Margin="0,0,16,0" RenderOptions.BitmapScalingMode="HighQuality"/>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="انباربان" FontSize="22" FontWeight="Bold" Foreground="{StaticResource BrushText}"/>
          <TextBlock Text="مدیریت انبار — ساده برای روزمره" Style="{StaticResource Subtitle}"/>
        </StackPanel>
        <TextBlock x:Name="TxtDbStatus" Grid.Column="2" VerticalAlignment="Center"
                   Foreground="{StaticResource BrushMuted}" FontSize="12" TextWrapping="Wrap" MaxWidth="280"/>
      </Grid>
    </Border>

    <Frame x:Name="MainFrame" Grid.Row="1" NavigationUIVisibility="Hidden" Margin="0"/>

    <Border Grid.Row="2" Background="#FF0D1412" Padding="12,8">
      <TextBlock HorizontalAlignment="Center" Foreground="{StaticResource BrushMuted}" FontSize="11"
                 Text="نسخه ۳ — پایگاه Access | بدون فرم داخل Access"/>
    </Border>
  </Grid>
</Window>
