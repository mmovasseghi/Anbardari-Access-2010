<Window x:Class="Anbarban.Views.Dialogs.LineEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="قلم کالا" SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushBgDeep}" FlowDirection="RightToLeft"
        FontFamily="{StaticResource FontUi}" MinWidth="400">
  <StackPanel Margin="20">
    <TextBlock Text="کالا" Foreground="{StaticResource BrushMuted}"/>
    <ComboBox x:Name="CboProduct" IsEditable="True" StaysOpenOnEdit="True"
              DisplayMemberPath="Name" SelectedValuePath="Id" Height="32" Margin="0,4,0,12"/>
    <TextBlock Text="تعداد" Foreground="{StaticResource BrushMuted}"/>
    <TextBox x:Name="TxtQty" Height="32" Margin="0,4,0,12"/>
    <StackPanel x:Name="DeptPanel" Visibility="Collapsed">
      <TextBlock Text="بخش" Foreground="{StaticResource BrushMuted}"/>
      <ComboBox x:Name="CboDept" DisplayMemberPath="Name" SelectedValuePath="Id" Height="32" Margin="0,4,0,12"/>
    </StackPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
      <Button Style="{StaticResource MenuTileButton}" Content="انصراف" Width="120" Margin="6" Click="OnCancel"/>
      <Button Style="{StaticResource PrimaryActionButton}" Content="تأیید" Width="120" Margin="6" Click="OnOk"/>
    </StackPanel>
  </StackPanel>
</Window>
