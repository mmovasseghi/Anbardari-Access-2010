<Window x:Class="Anbarban.Views.Dialogs.AnbarMessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="انباربان"
        Width="520" MinHeight="200" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Background="{StaticResource BrushBgDeep}"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource FontUi}">
  <Border BorderBrush="{StaticResource BrushAccentDark}" BorderThickness="1" CornerRadius="14" Margin="8">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <!-- نوار بالا — با موس جابه‌جایی -->
      <Border Grid.Row="0" Background="#FF0D1412" CornerRadius="14,14,0,0"
              Padding="16,12" MouseLeftButtonDown="OnDragMove" Cursor="SizeAll">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid Width="40" Height="40" Margin="0,0,12,0">
            <Ellipse Fill="#33FF5252" Stroke="#FFFFC107" StrokeThickness="2"/>
            <Ellipse Width="28" Height="28" Fill="#FFE53935"/>
            <TextBlock Text="✕" Foreground="White" FontSize="18" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
          </Grid>
          <TextBlock x:Name="TxtTitle" Grid.Column="1" FontSize="18" FontWeight="Bold"
                     Foreground="{StaticResource BrushText}" VerticalAlignment="Center"/>
        </Grid>
      </Border>
      <ScrollViewer Grid.Row="1" MaxHeight="320" Padding="20,16" VerticalScrollBarVisibility="Auto">
        <TextBlock x:Name="TxtMessage" TextWrapping="Wrap" FontSize="15" LineHeight="24"
                   Foreground="{StaticResource BrushMuted}"/>
      </ScrollViewer>
      <StackPanel x:Name="ButtonPanel" Grid.Row="2" Orientation="Horizontal"
                  HorizontalAlignment="Center" Margin="16,8,16,16"/>
    </Grid>
  </Border>
</Window>
