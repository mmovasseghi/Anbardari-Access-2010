<Window x:Class="Anbarban.Views.Dialogs.ConfirmOutgoingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تأیید خروج" Height="520" Width="800"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushBgDeep}"
        FlowDirection="RightToLeft" FontFamily="{StaticResource FontUi}">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock Text="لطفاً با حواله مطابقت دهید" Style="{StaticResource PageTitle}" FontSize="20"/>
    <TextBlock x:Name="TxtSummary" Grid.Row="1" Margin="0,12,0,12" TextWrapping="Wrap" Foreground="{StaticResource BrushMuted}"/>
    <DataGrid x:Name="Grid" Grid.Row="2" IsReadOnly="True" AutoGenerateColumns="False"
              Background="{StaticResource BrushBgCard}" Foreground="{StaticResource BrushText}">
      <DataGrid.Columns>
        <DataGridTextColumn Header="کالا" Binding="{Binding ProductName}" Width="*"/>
        <DataGridTextColumn Header="خروج" Binding="{Binding Quantity}" Width="70"/>
        <DataGridTextColumn Header="موجودی" Binding="{Binding CurrentStock}" Width="80"/>
        <DataGridTextColumn Header="بعد از خروج" Binding="{Binding AfterStock}" Width="90"/>
        <DataGridTextColumn Header="بخش" Binding="{Binding DepartmentName}" Width="120"/>
      </DataGrid.Columns>
    </DataGrid>
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
      <Button Style="{StaticResource MenuTileButton}" Content="بازگشت و اصلاح" Width="180" Margin="8" Click="OnBack"/>
      <Button Style="{StaticResource PrimaryActionButton}" Content="تأیید و ثبت نهایی" Width="200" Margin="8" Click="OnConfirm"/>
    </StackPanel>
  </Grid>
</Window>
