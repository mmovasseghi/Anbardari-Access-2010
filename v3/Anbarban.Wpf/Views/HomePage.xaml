<Page x:Class="Anbarban.Views.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:services="clr-namespace:Anbarban.Services"
      services:MouseWheelScrollHelper.Enable="True"
      Background="{StaticResource BrushBgDeep}"
      FlowDirection="RightToLeft"
      FontFamily="{StaticResource FontUi}"
      VerticalAlignment="Stretch">
  <Page.Resources>
    <Style x:Key="HomeTileIcon" TargetType="Image">
      <Setter Property="Width" Value="40"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality"/>
    </Style>
    <Style x:Key="HomeTileTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
      <Setter Property="TextAlignment" Value="Center"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="HomeTileHint" TargetType="TextBlock" BasedOn="{StaticResource Subtitle}">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="TextAlignment" Value="Center"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,3,0,0"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="HomeTileButton" TargetType="Button" BasedOn="{StaticResource MenuTileButton}">
      <Setter Property="MinHeight" Value="78"/>
      <Setter Property="Padding" Value="14,12"/>
      <Setter Property="Margin" Value="6"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style x:Key="HomePrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryActionButton}">
      <Setter Property="MinHeight" Value="78"/>
      <Setter Property="Padding" Value="14,12"/>
      <Setter Property="Margin" Value="6"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style x:Key="HomeSectionLabel" TargetType="TextBlock" BasedOn="{StaticResource SectionHeaderText}">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Margin" Value="6,0,6,8"/>
    </Style>
  </Page.Resources>

  <Grid VerticalAlignment="Stretch">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="1" MaxWidth="880" HorizontalAlignment="Center" Margin="24,16">
      <TextBlock Text="از همین‌جا شروع کنید" Foreground="{StaticResource BrushMuted}"
                 FontSize="13" TextAlignment="Center" Margin="0,0,0,16"/>

      <TextBlock Text="هر روز" Style="{StaticResource HomeSectionLabel}" HorizontalAlignment="Stretch"/>
      <UniformGrid Columns="2" Margin="0,0,0,4">
        <Button Style="{StaticResource HomePrimaryButton}" Click="OnIncoming">
          <StackPanel HorizontalAlignment="Center">
            <Image Source="/Assets/Icons/incoming.png" Style="{StaticResource HomeTileIcon}"/>
            <TextBlock Text="ثبت ورود" Style="{StaticResource HomeTileTitle}"/>
            <TextBlock Text="کالا وارد انبار می‌شود" Style="{StaticResource HomeTileHint}"/>
          </StackPanel>
        </Button>
        <Button Style="{StaticResource HomePrimaryButton}" Click="OnOutgoing">
          <StackPanel HorizontalAlignment="Center">
            <Image Source="/Assets/Icons/outgoing.png" Style="{StaticResource HomeTileIcon}"/>
            <TextBlock Text="ثبت خروج" Style="{StaticResource HomeTileTitle}"/>
            <TextBlock Text="با شماره حواله" Style="{StaticResource HomeTileHint}"/>
          </StackPanel>
        </Button>
        <Button Style="{StaticResource HomeTileButton}" Click="OnReports">
          <StackPanel HorizontalAlignment="Center">
            <Image Source="/Assets/Icons/reports.png" Style="{StaticResource HomeTileIcon}"/>
            <TextBlock Text="گزارش‌ها" Style="{StaticResource HomeTileTitle}"/>
            <TextBlock Text="ورود، خروج، موجودی" Style="{StaticResource HomeTileHint}"/>
          </StackPanel>
        </Button>
        <Button Style="{StaticResource HomeTileButton}" Click="OnStock">
          <StackPanel HorizontalAlignment="Center">
            <Image Source="/Assets/Icons/stock.png" Style="{StaticResource HomeTileIcon}"/>
            <TextBlock Text="موجودی انبار" Style="{StaticResource HomeTileTitle}"/>
            <TextBlock Text="الان چند تا داریم؟" Style="{StaticResource HomeTileHint}"/>
          </StackPanel>
        </Button>
      </UniformGrid>

      <TextBlock Text="یک‌بار تعریف کنید" Style="{StaticResource HomeSectionLabel}"
                 HorizontalAlignment="Stretch" Margin="6,18,6,8"/>
      <UniformGrid Columns="3">
        <Button Style="{StaticResource HomeTileButton}" Click="OnSuppliers">
          <StackPanel HorizontalAlignment="Center">
            <Image Source="/Assets/Icons/suppliers.png" Style="{StaticResource HomeTileIcon}"/>
            <TextBlock Text="ثبت فروشنده" Style="{StaticResource HomeTileTitle}"/>
            <TextBlock Text="از کی می‌خرید" Style="{StaticResource HomeTileHint}"/>
          </StackPanel>
        </Button>
        <Button Style="{StaticResource HomeTileButton}" Click="OnDepartments">
          <StackPanel HorizontalAlignment="Center">
            <Image Source="/Assets/Icons/departments.png" Style="{StaticResource HomeTileIcon}"/>
            <TextBlock Text="ثبت بخش" Style="{StaticResource HomeTileTitle}"/>
            <TextBlock Text="کالا کجا می‌رود" Style="{StaticResource HomeTileHint}"/>
          </StackPanel>
        </Button>
        <Button Style="{StaticResource HomeTileButton}" Click="OnProducts">
          <StackPanel HorizontalAlignment="Center">
            <Image Source="/Assets/Icons/products.png" Style="{StaticResource HomeTileIcon}"/>
            <TextBlock Text="ثبت کالا" Style="{StaticResource HomeTileTitle}"/>
            <TextBlock Text="نام و کد کالا" Style="{StaticResource HomeTileHint}"/>
          </StackPanel>
        </Button>
      </UniformGrid>
    </StackPanel>
  </Grid>
</Page>
