<Page x:Class="Anbarban.Views.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BrushBgDeep}"
      FlowDirection="RightToLeft"
      FontFamily="{StaticResource FontUi}">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20">
    <StackPanel MaxWidth="900" HorizontalAlignment="Center">
      <TextBlock Text="منوی اصلی" Style="{StaticResource PageTitle}" Margin="8,0,8,4"/>
      <TextBlock Text="روی هر کار بزنید — مثل دفتر، فقط منظم‌تر" Style="{StaticResource Subtitle}" Margin="8,0,8,20"/>

      <UniformGrid Columns="2" HorizontalAlignment="Stretch">
        <Button Style="{StaticResource PrimaryActionButton}" Content="ثبت ورود کالا" Click="OnIncoming"/>
        <Button Style="{StaticResource PrimaryActionButton}" Content="ثبت خروج / حواله" Click="OnOutgoing"/>
        <Button Style="{StaticResource MenuTileButton}" Content="مدیریت کالاها" Click="OnProducts"/>
        <Button Style="{StaticResource MenuTileButton}" Content="مدیریت فروشندگان" Click="OnSuppliers"/>
        <Button Style="{StaticResource MenuTileButton}" Content="مدیریت بخش‌ها" Click="OnDepartments"/>
        <Button Style="{StaticResource MenuTileButton}" Content="جستجو و گزارش‌ها" Click="OnReports"/>
        <Button Style="{StaticResource MenuTileButton}" Content="مشاهده موجودی انبار" Click="OnStock"/>
        <Button Style="{StaticResource MenuTileButton}" Content="کالاهای کم‌موجودی" Click="OnLowStock"/>
      </UniformGrid>

      <Button Style="{StaticResource MenuTileButton}" Content="خروج از برنامه" Margin="8,24,8,8"
              HorizontalAlignment="Stretch" Click="OnExit"/>
    </StackPanel>
  </ScrollViewer>
</Page>
