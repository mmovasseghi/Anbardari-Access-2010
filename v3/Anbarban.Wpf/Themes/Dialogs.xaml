<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style x:Key="LuxuryDialogBorder" TargetType="Border">
    <Setter Property="CornerRadius" Value="18"/>
    <Setter Property="Padding" Value="28,26"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BorderBrush" Value="{StaticResource BrushGold}"/>
    <Setter Property="Background">
      <Setter.Value>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="#FF161F1C" Offset="0"/>
          <GradientStop Color="#FF0E1412" Offset="1"/>
        </LinearGradientBrush>
      </Setter.Value>
    </Setter>
    <Setter Property="Effect">
      <Setter.Value>
        <DropShadowEffect BlurRadius="36" ShadowDepth="0" Opacity="0.65" Color="#FF000000"/>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="LuxuryDialogTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="22"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
    <Setter Property="TextAlignment" Value="Center"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>

  <Style x:Key="LuxuryDialogBody" TargetType="TextBlock">
    <Setter Property="FontSize" Value="16"/>
    <Setter Property="Foreground" Value="{StaticResource BrushMuted}"/>
    <Setter Property="TextAlignment" Value="Center"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="LineHeight" Value="26"/>
  </Style>

  <Style x:Key="LuxuryDialogOkButton" TargetType="Button" BasedOn="{StaticResource PrimaryActionButton}">
    <Setter Property="MinWidth" Value="160"/>
    <Setter Property="Padding" Value="32,14"/>
    <Setter Property="Margin" Value="0,20,0,0"/>
    <Setter Property="FontSize" Value="17"/>
  </Style>
</ResourceDictionary>
