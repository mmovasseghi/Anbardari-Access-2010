<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style x:Key="NavIconBadge" TargetType="Border">
    <Setter Property="Width" Value="40"/>
    <Setter Property="Height" Value="40"/>
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="Background" Value="#FF152822"/>
    <Setter Property="BorderBrush" Value="#FF2A4038"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="HorizontalAlignment" Value="Right"/>
    <Setter Property="Padding" Value="8"/>
  </Style>

  <Style x:Key="NavSectionTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="#FF6B8A7E"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="TextAlignment" Value="Right"/>
    <Setter Property="Margin" Value="20,18,20,6"/>
  </Style>

  <Style x:Key="HamburgerButton" TargetType="Button">
    <Setter Property="Width" Value="46"/>
    <Setter Property="Height" Value="46"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" CornerRadius="12" Padding="11"
                  Background="{TemplateBinding Background}"
                  BorderBrush="#FF2A4038" BorderThickness="1">
            <Grid Width="22" Height="16" VerticalAlignment="Center" HorizontalAlignment="Center">
              <Rectangle x:Name="L1" Height="2.2" RadiusX="1.1" RadiusY="1.1" VerticalAlignment="Top"
                         Fill="{StaticResource BrushGold}"/>
              <Rectangle x:Name="L2" Height="2.2" RadiusX="1.1" RadiusY="1.1" VerticalAlignment="Center"
                         Fill="{StaticResource BrushGold}"/>
              <Rectangle x:Name="L3" Height="2.2" RadiusX="1.1" RadiusY="1.1" VerticalAlignment="Bottom"
                         Fill="{StaticResource BrushGold}"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="#FF1A2623"/>
              <Setter TargetName="bd" Property="BorderBrush" Value="#FF3D5C50"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="bd" Property="Background" Value="#FF0F1815"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="NavDrawerButton" TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource FontUi}"/>
    <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="{StaticResource BrushGold}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="14,11"/>
    <Setter Property="Margin" Value="10,3"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="12" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="#FF152420"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="bd" Property="Background" Value="#FF1A2E28"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="NavDrawerButtonActive" TargetType="Button" BasedOn="{StaticResource NavDrawerButton}">
    <Setter Property="Background" Value="#FF1A2E28"/>
    <Setter Property="BorderThickness" Value="0,0,3,0"/>
  </Style>

</ResourceDictionary>
