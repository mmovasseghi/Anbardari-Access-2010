<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style x:Key="ReportDataGrid" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
    <Setter Property="FontSize" Value="16"/>
    <Setter Property="RowHeight" Value="44"/>
    <Setter Property="MinHeight" Value="300"/>
    <Setter Property="FlowDirection" Value="RightToLeft"/>
    <Setter Property="CanUserResizeColumns" Value="True"/>
    <Setter Property="CanUserSortColumns" Value="True"/>
    <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
    <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
  </Style>

  <Style x:Key="NavRailButton" TargetType="Button" BasedOn="{StaticResource MenuTileButton}">
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Padding" Value="14,12"/>
    <Setter Property="Margin" Value="4,2"/>
    <Setter Property="HorizontalContentAlignment" Value="Right"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Background" Value="Transparent"/>
  </Style>

  <Style x:Key="NavRailButtonActive" TargetType="Button" BasedOn="{StaticResource NavRailButton}">
    <Setter Property="Background" Value="#FF1A2E28"/>
    <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
    <Setter Property="BorderThickness" Value="0,0,3,0"/>
  </Style>

  <Style x:Key="ReportTypeListItem" TargetType="ListBoxItem">
    <Setter Property="FontFamily" Value="{StaticResource FontUi}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
    <Setter Property="Padding" Value="14,12"/>
    <Setter Property="Margin" Value="0,2"/>
    <Setter Property="HorizontalContentAlignment" Value="Right"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="#FF1F3D36"/>
              <Setter Property="Foreground" Value="{StaticResource BrushGold}"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="#FF152420"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SummaryBar" TargetType="Border">
    <Setter Property="Background" Value="#FF101A17"/>
    <Setter Property="BorderBrush" Value="{StaticResource BrushAccentDark}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="Padding" Value="16,10"/>
    <Setter Property="Margin" Value="0,0,0,10"/>
  </Style>

</ResourceDictionary>
