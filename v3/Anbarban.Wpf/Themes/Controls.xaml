<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <FontFamily x:Key="FontUi">Tahoma, Segoe UI</FontFamily>

  <Style x:Key="PageTitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource FontUi}"/>
    <Setter Property="FontSize" Value="26"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
  </Style>

  <Style x:Key="Subtitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource FontUi}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Foreground" Value="{StaticResource BrushMuted}"/>
  </Style>

  <Style x:Key="HintText" TargetType="TextBlock" BasedOn="{StaticResource Subtitle}">
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="LineHeight" Value="22"/>
    <Setter Property="Margin" Value="0,0,0,12"/>
  </Style>

  <Style x:Key="TileTitleText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource FontUi}"/>
    <Setter Property="FontSize" Value="17"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
    <Setter Property="TextAlignment" Value="Center"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
  </Style>

  <Style x:Key="SectionHeaderText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource FontUi}"/>
    <Setter Property="FontSize" Value="16"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource BrushGold}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style x:Key="TileSubtitleText" TargetType="TextBlock" BasedOn="{StaticResource Subtitle}">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="TextAlignment" Value="Center"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="Margin" Value="0,6,0,0"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>

  <Style x:Key="MenuTileButton" TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource FontUi}"/>
    <Setter Property="FontSize" Value="17"/>
    <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
    <Setter Property="Background" Value="{StaticResource BrushBgCard}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BrushAccentDark}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="16,12"/>
    <Setter Property="Margin" Value="6"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="12" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="#FF1A2623"/>
              <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{StaticResource BrushAccentDark}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="PrimaryActionButton" TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource FontUi}"/>
    <Setter Property="FontSize" Value="18"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
    <Setter Property="Background" Value="{StaticResource BrushAccentDark}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BrushGold}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="18,14"/>
    <Setter Property="Margin" Value="6"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="12" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="#FF2A5A4A"/>
              <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BrushGold}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="bd" Property="Background" Value="#FF1F4A3D"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource MenuTileButton}">
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Padding" Value="18,12"/>
    <Setter Property="Margin" Value="4,0"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
  </Style>

  <Style x:Key="CardPanel" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource BrushBgCard}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BrushAccentDark}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="14"/>
    <Setter Property="Padding" Value="20"/>
    <Setter Property="Margin" Value="8"/>
  </Style>
</ResourceDictionary>
