<UserControl x:Class="Anbarban.Controls.JalaliDatePicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             FontFamily="{StaticResource FontUi}">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>

    <TextBox x:Name="TxtDate" Grid.Column="0"
             VerticalContentAlignment="Center"
             ToolTip="مثال: 1405/07/01 — یا از تقویم انتخاب کنید"
             LostFocus="OnTextLostFocus"
             KeyDown="OnTextKeyDown"/>

    <Button x:Name="BtnOpen" Grid.Column="1" Style="{StaticResource JalaliCalOpenButton}"
            Click="OnTogglePopup" ToolTip="باز کردن تقویم شمسی"/>

    <Popup x:Name="CalPopup" PlacementTarget="{Binding ElementName=TxtDate}" Placement="Bottom"
           StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
      <Border Background="#FF0F1614" BorderBrush="{StaticResource BrushAccentDark}" BorderThickness="1"
              CornerRadius="12" Padding="14" Margin="0,6,0,0">
        <Border.Effect>
          <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.45" Color="#000000"/>
        </Border.Effect>
        <StackPanel MinWidth="300">
          <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource JalaliCalNavButton}" Content="‹" Click="OnPrevMonth"/>
            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
              <TextBlock x:Name="TxtMonthYear" FontSize="16" FontWeight="SemiBold"
                         Foreground="{StaticResource BrushGold}" HorizontalAlignment="Center"/>
              <TextBlock x:Name="TxtGregorianHint" FontSize="11" Foreground="{StaticResource BrushMuted}"
                         HorizontalAlignment="Center" Margin="0,2,0,0"/>
            </StackPanel>
            <Button Grid.Column="2" Style="{StaticResource JalaliCalNavButton}" Content="›" Click="OnNextMonth"/>
          </Grid>

          <UniformGrid Rows="1" Columns="7" Margin="0,0,0,6">
            <TextBlock Text="ش" HorizontalAlignment="Center" Foreground="{StaticResource BrushMuted}" FontSize="12"/>
            <TextBlock Text="ی" HorizontalAlignment="Center" Foreground="{StaticResource BrushMuted}" FontSize="12"/>
            <TextBlock Text="د" HorizontalAlignment="Center" Foreground="{StaticResource BrushMuted}" FontSize="12"/>
            <TextBlock Text="س" HorizontalAlignment="Center" Foreground="{StaticResource BrushMuted}" FontSize="12"/>
            <TextBlock Text="چ" HorizontalAlignment="Center" Foreground="{StaticResource BrushMuted}" FontSize="12"/>
            <TextBlock Text="پ" HorizontalAlignment="Center" Foreground="{StaticResource BrushMuted}" FontSize="12"/>
            <TextBlock Text="ج" HorizontalAlignment="Center" Foreground="{StaticResource BrushMuted}" FontSize="12"/>
          </UniformGrid>

          <UniformGrid x:Name="DayGrid" Rows="6" Columns="7"/>

          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
            <Button Style="{StaticResource ToolbarButton}" Content="امروز" Click="OnPickToday" Padding="16,8"/>
            <Button Style="{StaticResource ToolbarButton}" Content="بستن" Click="OnClosePopup" Margin="8,0,0,0" Padding="16,8"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Popup>
  </Grid>
</UserControl>
