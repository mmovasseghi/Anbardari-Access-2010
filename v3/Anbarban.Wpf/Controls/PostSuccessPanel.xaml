<UserControl x:Class="Anbarban.Controls.PostSuccessPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BrushBgDeep}"
             FlowDirection="RightToLeft"
             FontFamily="{StaticResource FontUi}">
  <Grid VerticalAlignment="Stretch">
    <Border Style="{StaticResource LuxuryDialogBorder}" MaxWidth="560" Margin="24"
            HorizontalAlignment="Center" VerticalAlignment="Center" Padding="36,40">
      <StackPanel>
        <Border Width="104" Height="104" CornerRadius="52" HorizontalAlignment="Center" Margin="0,0,0,20">
          <Border.Background>
            <RadialGradientBrush GradientOrigin="0.35,0.35">
              <GradientStop Color="#FF2D9B86" Offset="0"/>
              <GradientStop Color="#FF0A0E0D" Offset="1"/>
            </RadialGradientBrush>
          </Border.Background>
          <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="#FFF0D878" Offset="0"/>
              <GradientStop Color="#FFC9A227" Offset="1"/>
            </LinearGradientBrush>
          </Border.BorderBrush>
          <Border.BorderThickness>2.5</Border.BorderThickness>
          <Image Source="/Assets/Icons/check-circle.png" Width="62" Height="62"
                 RenderOptions.BitmapScalingMode="HighQuality"/>
        </Border>
        <TextBlock x:Name="TxtHeadline" Text="درخواست شما انجام شد"
                   Style="{StaticResource LuxuryDialogTitle}" FontSize="26" Margin="0,0,0,8"/>
        <TextBlock x:Name="TxtSubtitle" Style="{StaticResource LuxuryDialogBody}"
                   Text="ثبت نهایی با موفقیت انجام شد و موجودی انبار به‌روز شد." Margin="0,0,0,6"/>
        <TextBlock x:Name="TxtDetail" Style="{StaticResource LuxuryDialogBody}"
                   Foreground="{StaticResource BrushGold}" FontSize="15" Margin="0,0,0,28"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
          <Button x:Name="BtnNew" Style="{StaticResource PrimaryActionButton}"
                  Content="ثبت سند جدید" Padding="26,14" Margin="6,0" Click="OnNew"/>
          <Button x:Name="BtnHome" Style="{StaticResource MenuTileButton}"
                  Content="بازگشت به خانه" Padding="22,14" Margin="6,0" Click="OnHome"/>
          <Button x:Name="BtnUnlock" Style="{StaticResource ToolbarButton}"
                  Content="اصلاح با کد مدیر" Padding="18,12" Margin="6,0" Click="OnUnlock"/>
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
