<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <appSettings>
    <!-- مسیر دیتابیس نسبت به پوشه exe؛ در پرتابل: Data\Inventory.accdb -->
    <add key="DatabasePath" value="Data\Inventory.accdb" />
    <add key="UnlockOrgSalt" value="Anbarban-Offline-2010" />
  </appSettings>
</configuration>
